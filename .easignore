# Replaces ALL .gitignore files. Upload only native application inputs.
/*
!/.easignore
!/LICENSE
!/apps
/apps/*
!/apps/mobile
/apps/mobile/*
!/apps/mobile/app.json
!/apps/mobile/eas.json
!/apps/mobile/package.json
!/apps/mobile/package-lock.json
!/apps/mobile/metro.config.js
!/apps/mobile/tsconfig.json
!/apps/mobile/assets
!/apps/mobile/src
!/packages
/packages/*
!/packages/core
/packages/core/*
!/packages/core/package.json
!/packages/core/src
# No local data or credentials inside the included source trees either.
**/node_modules/
**/.env*
**/.expo/
**/*.test.*
**/*.private.*
**/credentials.json
**/*.log
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.mobileprovision
**/*.sqlite*
**/*.db
**/*.safetensors
**/*.gguf
**/*.ckpt
**/*.pth
**/*.pt
**/*.bin
