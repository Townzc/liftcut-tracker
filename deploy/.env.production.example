# Copy this file to .env.production on the Alibaba Cloud server. Do not commit it.
# The domain must resolve to this server before Caddy can obtain the TLS certificate.
PRIMARY_DOMAIN=liftcuttracker.com

# These values are safe to expose to the browser but are required while building the image.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_WECHAT_LOGIN_ENABLED=false

# Server-only AI configuration. Choose exactly one provider configuration that the app uses.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=REPLACE_WITH_A_SERVER_ONLY_SECRET
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Leave these blank unless using the corresponding provider.
LOCAL_AI_BASE_URL=
LOCAL_AI_API_KEY=
LOCAL_AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
