# Copy this file to .env.local before running.

# Supabase project URL, e.g. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (public client key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# P1 application transactions: dedicated liftcut_agent login on the SAME Supabase database.
# Server-only; never use postgres/service_role or put this in a NEXT_PUBLIC variable.
# Apply supabase/schema.sql and migrations first. See docs/research/2026-10-13-p1-application-transactions.md.
AGENT_DATABASE_URL=

# AI Provider: deepseek | local | openai_compatible
# Defaults to deepseek when omitted.
AI_PROVIDER=deepseek

# DeepSeek production provider (server-only)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REQUEST_TIMEOUT_MS=120000

# Local research provider (OpenAI-compatible)
LOCAL_AI_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_AI_API_KEY=EMPTY
LOCAL_AI_MODEL=liftcut-coach
LOCAL_AI_REQUEST_TIMEOUT_MS=120000

# Generic OpenAI-compatible provider (server-only)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT_MS=30000

# WeChat OAuth login (set to true only after Supabase custom provider "custom:wechat" is configured)
NEXT_PUBLIC_WECHAT_LOGIN_ENABLED=false

# W1b (server-only). Apply both W1 migrations and provision the restricted
# liftcut_workout login before enabling. Never use postgres/service_role here.
FEATURE_TODAY_SESSION=false
WORKOUT_DATABASE_URL=
# Optional PEM root CA for a hosted database with a private certificate authority.
# Remote connections always verify both certificate chain and hostname. For
# Supabase shared pooler use its official root CA, never sslmode=no-verify.
WORKOUT_DATABASE_CA_CERT=

# Server-only random secret (at least 32 characters), independent from provider keys.
# Signs immutable, owner-bound AI entry drafts; a rotation expires unsent drafts.
COACH_SIGNING_SECRET=
