# Public values only (they ship inside the app). Never put service keys here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
EXPO_PUBLIC_API_URL=https://www.liftcuttracker.com
# Keep false until real SMTP, native secure crypto and signed-iPhone callbacks pass.
EXPO_PUBLIC_MOBILE_EMAIL_SIGNUP=false
# Independent from the server flag. Keep false until signed-device deletion passes.
EXPO_PUBLIC_MOBILE_ACCOUNT_DELETION=false
