{
  "cli": {
    "version": ">= 25.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": true,
      "android": { "buildType": "apk" },
      "ios": { "buildConfiguration": "Release", "simulator": false, "image": "macos-tahoe-26.6-xcode-27.0" }
    },
    "ios-simulator": {
      "extends": "preview",
      "autoIncrement": false,
      "ios": { "simulator": true }
    }
  }
}
